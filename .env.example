# AutoRide Backend Environment Variables
PORT=8000

# Neon Serverless PostgreSQL Database Connection String Example:
# Replace with your actual connection string from https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

SUPERADMIN_USERNAME=username
SUPERADMIN_PASSWORD=password

# Cloudinary Storage Configuration for Ride Proof Screenshots:
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternatively, provide single URL:
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Appwrite Storage Configuration for Large APK Hosting (No 10MB limit! Free 50MB+):
# Sign up at https://cloud.appwrite.io
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_secret_key
APPWRITE_BUCKET_ID=your_bucket_id
